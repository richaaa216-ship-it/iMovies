# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Connection (Auto-detects live MongoDB or switches to embedded JSON engine)
MONGO_URI=mongodb://localhost:27017/imovies

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# TMDB (The Movie Database) API Configuration
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/w500

# Direct Payment & Transaction Engine
PAYMENT_MODE=DIRECT

# Brevo (Sendinblue) Transactional Email Configuration
BREVO_API_KEY=your_brevo_api_key_here
SENDER_EMAIL=your_sender_email@example.com
SENDER_NAME=iMovies
